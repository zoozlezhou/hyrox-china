---
import Layout from '../layouts/Layout.astro';

const stats = [
  { label: '全球赛事', value: '100+', note: '2026年' },
  { label: '参赛人数', value: '50万+', note: '累计' },
  { label: '国家/地区', value: '30+', note: '覆盖' },
  { label: '训练站点', value: '8', note: '标准化' },
];

const workouts = [
  { name: '滑雪机', distance: '1000m', icon: '🎿' },
  { name: '推雪橇', distance: '50m', icon: '🛷' },
  { name: '拉雪橇', distance: '50m', icon: '🏋️' },
  { name: '波比跳远', reps: '80次', icon: '💪' },
  { name: '划船机', distance: '1000m', icon: '🚣' },
  { name: '农夫行走', distance: '200m', icon: '🏃' },
  { name: '沙袋弓步', distance: '100m', icon: '🦵' },
  { name: '墙球', reps: '75次', icon: '⚾' },
];
---

<Layout title="Hyrox 中国 - 全球健身竞赛">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-600 to-blue-800 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="text-center">
        <h1 class="text-5xl font-bold mb-6">
          8km 跑步 + 8 个功能训练
        </h1>
        <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
          HYROX 是全球最大的健身竞赛，标准化赛制让你在全球任何赛事中都能公平竞争。
          1km 跑步 + 1 个训练站点，重复 8 次。
        </p>
        <div class="flex justify-center gap-4">
          <a href="/events" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-blue-50 transition">
            查看赛事
          </a>
          <a href="/training" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/10 transition">
            开始训练
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map(stat => (
          <div class="text-center">
            <div class="text-4xl font-bold text-blue-600 mb-2">{stat.value}</div>
            <div class="text-gray-600 font-medium">{stat.label}</div>
            <div class="text-sm text-gray-400 mt-1">{stat.note}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What is Hyrox -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">什么是 HYROX？</h2>
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-lg text-gray-700 mb-6">
            HYROX 结合了跑步和功能训练，赛制全球统一：
          </p>
          <ul class="space-y-4">
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-3">1.</span>
              <span>先跑 1 公里，然后完成 1 个功能训练站点</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-3">2.</span>
              <span>重复 8 次，总计 8km 跑步 + 8 个训练站</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-3">3.</span>
              <span>室内大型场馆，体育场式氛围</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-3">4.</span>
              <span>芯片计时，全球排行榜可比较成绩</span>
            </li>
          </ul>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-8">
          <h3 class="text-xl font-bold mb-6">8 个训练站点</h3>
          <div class="grid grid-cols-2 gap-4">
            {workouts.map((w, i) => (
              <div class="flex items-center p-3 bg-blue-50 rounded-lg">
                <span class="text-2xl mr-3">{w.icon}</span>
                <div>
                  <div class="font-medium text-sm">{i + 1}. {w.name}</div>
                  <div class="text-xs text-gray-500">{'distance' in w ? w.distance : w.reps}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divisions -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">4 个组别，适合所有人</h2>
      <div class="grid md:grid-cols-4 gap-6">
        <div class="border-2 border-blue-200 rounded-xl p-6 hover:border-blue-400 transition">
          <div class="text-3xl mb-3">🏃</div>
          <h3 class="text-xl font-bold mb-2">Open</h3>
          <p class="text-gray-600 text-sm">标准重量，适合所有人。有挑战但可实现。</p>
        </div>
        <div class="border-2 border-orange-200 rounded-xl p-6 hover:border-orange-400 transition">
          <div class="text-3xl mb-3">💪</div>
          <h3 class="text-xl font-bold mb-2">Pro</h3>
          <p class="text-gray-600 text-sm">更重重量，为有经验的选手设计。</p>
        </div>
        <div class="border-2 border-green-200 rounded-xl p-6 hover:border-green-400 transition">
          <div class="text-3xl mb-3">👥</div>
          <h3 class="text-xl font-bold mb-2">Doubles</h3>
          <p class="text-gray-600 text-sm">双人组队，分担训练量，一起完成。</p>
        </div>
        <div class="border-2 border-purple-200 rounded-xl p-6 hover:border-purple-400 transition">
          <div class="text-3xl mb-3">🏆</div>
          <h3 class="text-xl font-bold mb-2">Relay</h3>
          <p class="text-gray-600 text-sm">4 人接力，每人 2km + 2 个训练站。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-blue-600 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">准备好迎接挑战了吗？</h2>
      <p class="text-blue-100 mb-8 text-lg">
        无论你是健身新手还是老手，HYROX 都有适合你的组别。
      </p>
      <a href="/training" class="inline-block bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-blue-50 transition">
        查看训练指南 →
      </a>
    </div>
  </section>
</Layout>
