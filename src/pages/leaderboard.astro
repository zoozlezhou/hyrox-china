---
import Layout from '../layouts/Layout.astro';

const leaderboard = [
  { rank: 1, name: '张伟', city: '上海', time: '1:08:23', division: 'Men 25-29', event: 'Hyrox London 2026' },
  { rank: 2, name: '李明', city: '北京', time: '1:10:45', division: 'Men 30-34', event: 'Hyrox Singapore 2026' },
  { rank: 3, name: '王芳', city: '深圳', time: '1:15:32', division: 'Women 25-29', event: 'Hyrox Sydney 2026' },
  { rank: 4, name: '陈强', city: '广州', time: '1:18:06', division: 'Men 35-39', event: 'Hyrox Tokyo 2026' },
  { rank: 5, name: '刘洋', city: '成都', time: '1:20:18', division: 'Men 25-29', event: 'Hyrox New York 2026' },
  { rank: 6, name: '赵雪', city: '杭州', time: '1:22:44', division: 'Women 30-34', event: 'Hyrox London 2026' },
  { rank: 7, name: '孙磊', city: '南京', time: '1:24:55', division: 'Men 40-44', event: 'Hyrox Singapore 2026' },
  { rank: 8, name: '周静', city: '武汉', time: '1:26:33', division: 'Women 25-29', event: 'Hyrox Tokyo 2026' },
  { rank: 9, name: '吴昊', city: '上海', time: '1:28:10', division: 'Men 30-34', event: 'Hyrox Sydney 2026' },
  { rank: 10, name: '郑凯', city: '北京', time: '1:29:47', division: 'Men 35-39', event: 'Hyrox New York 2026' },
];

const divisions = ['全部', 'Men 25-29', 'Men 30-34', 'Men 35-39', 'Men 40-44', 'Women 25-29', 'Women 30-34', 'Women 35-39'];
---

<Layout title="排行榜 - Hyrox 中国">
  <!-- Hero -->
  <section class="bg-gradient-to-r from-green-700 to-teal-800 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-bold mb-4">中国选手排行榜</h1>
      <p class="text-green-100 text-lg">全球赛事成绩汇总，按年龄组排名</p>
    </div>
  </section>

  <!-- Leaderboard -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Filters -->
      <div class="mb-8">
        <div class="flex flex-wrap gap-2">
          {divisions.map((d, i) => (
            <button class={`px-4 py-2 rounded-lg text-sm font-medium transition ${
              i === 0 ? 'bg-green-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
            }`}>
              {d}
            </button>
          ))}
        </div>
      </div>

      <!-- Table -->
      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase">排名</th>
              <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase">选手</th>
              <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase">城市</th>
              <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase">成绩</th>
              <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase">组别</th>
              <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase">赛事</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {leaderboard.map(entry => (
              <tr class="hover:bg-green-50 transition">
                <td class="px-6 py-4">
                  <span class={`inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold ${
                    entry.rank === 1 ? 'bg-yellow-100 text-yellow-700' :
                    entry.rank === 2 ? 'bg-gray-100 text-gray-600' :
                    entry.rank === 3 ? 'bg-orange-100 text-orange-700' :
                    'bg-gray-50 text-gray-500'
                  }`}>
                    {entry.rank}
                  </span>
                </td>
                <td class="px-6 py-4 font-semibold text-gray-900">{entry.name}</td>
                <td class="px-6 py-4 text-gray-500">{entry.city}</td>
                <td class="px-6 py-4">
                  <span class="font-mono font-bold text-green-700">{entry.time}</span>
                </td>
                <td class="px-6 py-4">
                  <span class="px-2 py-1 bg-blue-50 text-blue-700 rounded text-xs font-medium">{entry.division}</span>
                </td>
                <td class="px-6 py-4 text-gray-500 text-sm">{entry.event}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Info -->
      <div class="mt-8 bg-blue-50 rounded-xl p-6">
        <h3 class="font-bold text-blue-900 mb-2">📊 关于排行榜</h3>
        <p class="text-blue-700 text-sm">
          排行榜数据来源于 Hyrox 全球官方成绩系统。中国选手在全球各赛事的成绩统一汇总，
          按年龄组和性别分组排名。所有赛事采用完全相同的赛制和标准，确保成绩可比较。
        </p>
      </div>
    </div>
  </section>
</Layout>
