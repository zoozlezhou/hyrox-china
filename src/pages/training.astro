---
import Layout from '../layouts/Layout.astro';

const stations = [
  {
    id: 1,
    name: '滑雪机 SkiErg',
    distance: '1000m',
    icon: '🎿',
    description: '模拟越野滑雪，考验上肢耐力和核心稳定性。',
    tips: ['保持稳定的节奏', '利用体重下压', '核心收紧，不要过度后仰'],
    muscle: ['背阔肌', '肱二头肌', '核心'],
  },
  {
    id: 2,
    name: '推雪橇 Heavy Sled Push',
    distance: '50m (4次×12.5m)',
    icon: '🛷',
    description: '推动 152kg（男）/ 102kg（女）雪橇，考验腿部爆发力。',
    tips: ['低重心，手臂伸直', '小步快频', '腿部发力为主'],
    muscle: ['股四头肌', '臀大肌', '小腿'],
  },
  {
    id: 3,
    name: '拉雪橇 Sled Pull',
    distance: '50m (4次×12.5m)',
    icon: '🏋️',
    description: '用绳索拉动 76kg（男）/ 51kg（女）雪橇，考验上肢拉力。',
    tips: ['交替拉绳，不要同时用双手', '脚踩绳索时稳住', '核心保持紧张'],
    muscle: ['背阔肌', '肱二头肌', '前臂'],
  },
  {
    id: 4,
    name: '波比跳远 Burpee Broad Jump',
    distance: '80m (8次×10m)',
    icon: '💪',
    description: '做波比跳后向前跳跃 10 米，全身爆发力考验。',
    tips: ['波比跳要标准：胸触地', '跳跃尽量远', '落地缓冲，保护膝盖'],
    muscle: ['全身', '胸肌', '股四头肌'],
  },
  {
    id: 5,
    name: '划船机 Rowing',
    distance: '1000m',
    icon: '🚣',
    description: '室内划船机，考验心肺耐力和全身协调。',
    tips: ['60% 腿部、30% 核心、10% 手臂', '保持稳定的桨频', '不要过度后仰'],
    muscle: ['背阔肌', '股四头肌', '核心'],
  },
  {
    id: 6,
    name: '农夫行走 Farmers Carry',
    distance: '200m (4次×50m)',
    icon: '🏃',
    description: '双手各提 32kg（男）/ 24kg（女）壶铃行走。',
    tips: ['挺胸收腹，不要驼背', '小步快频', '握力是关键瓶颈'],
    muscle: ['前臂', '斜方肌', '核心'],
  },
  {
    id: 7,
    name: '沙袋弓步 Lunges',
    distance: '100m',
    icon: '🦵',
    description: '肩扛 20kg（男）/ 10kg（女）沙袋做弓步走。',
    tips: ['后膝接近地面', '上身保持直立', '步幅不要太大'],
    muscle: ['股四头肌', '臀大肌', '核心'],
  },
  {
    id: 8,
    name: '墙球 Wall Balls',
    distance: '75次',
    icon: '⚾',
    description: '将 6kg（男）/ 4kg（女）球抛至 3.05m（男）/ 2.72m（女）目标。',
    tips: ['深蹲发力，不要只用手臂', '球到最高点时接住', '保持节奏，不要前快后慢'],
    muscle: ['股四头肌', '肩三角肌', '核心'],
  },
];

const trainingPlans = [
  { name: '新手入门', weeks: '8 周', level: '零基础', desc: '建立基础体能，完成第一次 Hyrox' },
  { name: '进阶提升', weeks: '12 周', level: '有经验', desc: '提升成绩，突破个人最佳' },
  { name: '赛前备战', weeks: '6 周', level: '备赛中', desc: '针对性训练，优化比赛策略' },
];
---

<Layout title="训练指南 - Hyrox 中国">
  <!-- Hero -->
  <section class="bg-gradient-to-r from-orange-600 to-red-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-bold mb-4">训练指南</h1>
      <p class="text-orange-100 text-lg">掌握 8 个标准训练站点，为比赛做好准备</p>
    </div>
  </section>

  <!-- 8 Stations -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-8">8 个标准训练站点</h2>
      <div class="space-y-8">
        {stations.map(station => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
            <div class="md:flex">
              <div class="md:w-1/4 bg-gradient-to-br from-blue-50 to-blue-100 p-8 flex flex-col items-center justify-center">
                <span class="text-5xl mb-3">{station.icon}</span>
                <span class="text-sm font-bold text-blue-600">站点 {station.id}</span>
                <span class="text-lg font-bold text-gray-900 mt-1">{station.distance}</span>
              </div>
              <div class="md:w-3/4 p-8">
                <h3 class="text-xl font-bold text-gray-900 mb-2">{station.name}</h3>
                <p class="text-gray-600 mb-4">{station.description}</p>
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <h4 class="font-semibold text-sm text-gray-500 uppercase mb-2">💡 技巧要点</h4>
                    <ul class="space-y-1">
                      {station.tips.map(tip => (
                        <li class="text-sm text-gray-700 flex items-start">
                          <span class="text-green-500 mr-2">✓</span>
                          {tip}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="font-semibold text-sm text-gray-500 uppercase mb-2">🎯 目标肌群</h4>
                    <div class="flex flex-wrap gap-2">
                      {station.muscle.map(m => (
                        <span class="px-3 py-1 bg-orange-50 text-orange-700 rounded-full text-sm">{m}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Training Plans -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-8">训练计划</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {trainingPlans.map(plan => (
          <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition">
            <h3 class="text-xl font-bold mb-2">{plan.name}</h3>
            <div class="flex gap-3 mb-4">
              <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-medium">{plan.weeks}</span>
              <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs font-medium">{plan.level}</span>
            </div>
            <p class="text-gray-600 text-sm mb-4">{plan.desc}</p>
            <button class="w-full bg-blue-600 text-white py-2 rounded-lg font-medium hover:bg-blue-700 transition">
              查看详情
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
